# ============================================================================
# Edge 入口反代 —— 生产
#
#   cloud.airouterx.com    -> sub2site:80    （用户端静态站；/api 与网关路径转 sub2api）
#   sub-api.airouterx.com  -> sub2api:8080   （sub2api 原生，含管理端）
#
# 关键设计：sub2site 只做静态文件服务，所有 API 与网关路由在本层决策。
# 这样 sub2site 容器不暴露端口、不含反代规则，换域名或加域名只改这一份配置，
# 不需要重建镜像。
#
# 部署位置：~/edge-deploy/nginx.conf（整份挂成 /etc/nginx/nginx.conf）
# 换机器时连同 edge-docker-compose.example.yml 一起拷过去，改域名即可。
#
# 改配置：docker exec edge-nginx nginx -t && docker exec edge-nginx nginx -s reload
# 改端口映射：必须 docker compose up -d 重建，reload 不够
# ============================================================================
worker_processes auto;
events { worker_connections 4096; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format edge '$remote_addr - $host "$request" $status $body_bytes_sent '
                    '"$http_user_agent" ${upstream_response_time}s';
    access_log /var/log/nginx/access.log edge;
    error_log  /var/log/nginx/error.log warn;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    keepalive_requests 1000;

    # AI 网关特性：大请求体 + 长连接 + 流式响应
    client_max_body_size 256m;
    client_body_timeout 60s;
    proxy_connect_timeout 60s;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_request_buffering off;
    proxy_buffering off;          # SSE 流式响应必须关闭缓冲
    proxy_cache off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # 公共转发头，在 http 块统一声明，各 location 继承。
    # Host 传 $host（即用户实际访问的域名）而不是后端域名：
    # sub2api 的 CanonicalizeReturnURL 会做同源校验，传错会导致 OAuth / 支付回跳失败。
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    # 用 Docker 内嵌 DNS 做运行时解析，目标服务重启换 IP 时 edge 不用重启
    resolver 127.0.0.11 ipv6=off valid=10s;

    # 未匹配域名（含以 IP 直接访问）一律断开，不暴露任何服务
    server {
        listen 80 default_server;
        server_name _;
        return 444;
    }

    # ---- 用户端 ----
    server {
        listen 80;
        server_name cloud.airouterx.com;

        # ACME HTTP-01 质询。放在最前面，且**永远不要**跳转到 HTTPS——
        # 续签时 Let's Encrypt 会明文访问这个路径。
        location ^~ /.well-known/acme-challenge/ {
            root /var/www/acme;
            default_type "text/plain";
        }

        # 管理接口在用户端域名上一律拒绝。
        # 即便拿到管理员 JWT 也无法从这个域名调用；管理端请走 sub-api 域名。
        # 用 ^~ 前缀匹配（优先级高于正则），返回 404 而非 403，不暴露路径存在性。
        location ^~ /api/v1/admin {
            return 404;
        }

        # 用户面板 API
        location ^~ /api/ {
            set $upstream http://sub2api:8080;
            proxy_pass $upstream$request_uri;
        }

        # 模型网关的四组顶层路由。少一组都会让对应客户端调不通：
        #   /v1          OpenAI / Anthropic 兼容
        #   /v1beta      Gemini
        #   /antigravity Antigravity
        #   /backend-api Codex
        location ~ ^/(v1beta|v1|antigravity|backend-api)(/|$) {
            set $upstream http://sub2api:8080;
            proxy_pass $upstream$request_uri;
        }

        # 其余交给 sub2site 静态站（内含 SPA 回落）
        location / {
            set $upstream http://sub2site:80;
            proxy_pass $upstream$request_uri;
        }
    }

    # ---- sub2api 原生（含管理端）----
    server {
        listen 80;
        server_name sub-api.airouterx.com;

        location ^~ /.well-known/acme-challenge/ {
            root /var/www/acme;
            default_type "text/plain";
        }

        location / {
            set $upstream http://sub2api:8080;
            proxy_pass $upstream$request_uri;
        }
    }
}

# ============================================================================
# 启用 HTTPS（证书签发后）
#
# 前提：DNS 已指向本机，且上面的 acme-challenge location 可访问。
#
# 1) 宿主上装 certbot，用 webroot 模式签发（不停 nginx）：
#
#      sudo dnf install -y certbot
#      sudo certbot certonly --webroot -w ~/edge-deploy/acme-webroot \
#           -d cloud.airouterx.com -d sub-api.airouterx.com \
#           --email <你的邮箱> --agree-tos --no-eff-email
#
#    证书落在 /etc/letsencrypt/live/cloud.airouterx.com/
#
# 2) compose 打开 "443:443"，并挂载：
#      - /etc/letsencrypt:/etc/letsencrypt:ro
#
# 3) 每个业务 server 块加 443 监听：
#
#      server {
#          listen 443 ssl;
#          http2 on;                      # ← nginx 1.25+ 的写法
#          server_name cloud.airouterx.com;
#          ssl_certificate     /etc/letsencrypt/live/cloud.airouterx.com/fullchain.pem;
#          ssl_certificate_key /etc/letsencrypt/live/cloud.airouterx.com/privkey.pem;
#          ssl_protocols TLSv1.2 TLSv1.3;
#          ssl_prefer_server_ciphers off;
#          ssl_session_cache shared:SSL:10m;
#          ssl_session_timeout 1d;
#          ... 其余 location 原样照抄 ...
#      }
#
#    ⚠ nginx 版本决定 http2 的写法：
#       1.24 及以下：listen 443 ssl http2;   （独立的 http2 on; 会报 unknown directive）
#       1.25 及以上：listen 443 ssl; + http2 on;
#      本配置用的镜像见 compose，别照抄错版本。
#
# 4) 80 端口加跳转。**先用 302，稳定几天再换 301**：
#      301 会被浏览器永久缓存，一旦要回退，你没有任何办法远程清掉用户的缓存。
#
#      location / { return 302 https://$host$request_uri; }
#
#    注意跳转要写在 acme-challenge location 之后，别把质询也跳走了。
#
# 5) 自动续签（certbot 的 systemd timer 会自动装上，只需补 reload 钩子）：
#
#      sudo mkdir -p /etc/letsencrypt/renewal-hooks/deploy
#      sudo tee /etc/letsencrypt/renewal-hooks/deploy/reload-edge.sh >/dev/null <<'SH'
#      #!/bin/sh
#      docker exec edge-nginx nginx -s reload
#      SH
#      sudo chmod +x /etc/letsencrypt/renewal-hooks/deploy/reload-edge.sh
#
#      systemctl list-timers | grep certbot        # 确认 timer 已启用
#      sudo certbot renew --dry-run                # 演练一次，必须通过
# ============================================================================
